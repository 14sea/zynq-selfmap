{
 "schema": "probe_design",
 "schema_version": 1,
 "name": "s2b",
 "what": "the probe design of S2.5 (docs/s2_plan.md, sections 45 and 46): LUT RAM at 110 sites behind eight registers on M_AXI_GP0, every memory loaded with a word of its own",
 "base": "0x40000000",
 "id": "0x53324231",
 "registers": {
  "ID": {
   "offset": "0x00",
   "read": "the fixed word",
   "write": "ignored"
  },
  "SITE": {
   "offset": "0x04",
   "read": "what was last written: the site number (bits 6..0) and whether a write goes to every site (bit 8)",
   "write": "which site a read of RAM_DATA answers for and a write of RAM_DATA goes to; bit 8: to every site"
  },
  "COUNT": {
   "offset": "0x08",
   "read": "a counter of FCLK0, free running",
   "write": "ignored"
  },
  "RAM_ADDR": {
   "offset": "0x0c",
   "read": "the address, six bits",
   "write": "the address of every memory, for reading and for writing"
  },
  "RAM_DATA": {
   "offset": "0x10",
   "read": "the four outputs at that address of the site SITE names, bit k from memory k",
   "write": "one write of bit k into memory k at that address \u2014 of the site SITE names, or of every site"
  },
  "NONE": {
   "offset": "0x14",
   "read": "zero",
   "write": "ignored"
  },
  "CHECK": {
   "offset": "0x18",
   "read": "at that address, over all sites, for memory k: bit k \u2014 a site holds a one; bit 4+k \u2014 every site holds a one; bit 8+k \u2014 the parity of what the sites hold",
   "write": "ignored"
  },
  "WRITES": {
   "offset": "0x1c",
   "read": "writes of RAM_DATA since the design was loaded (bits 15..0)",
   "write": "ignored"
  }
 },
