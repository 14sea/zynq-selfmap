# zynq-selfmap probe design s2b — constraints. docs/s2_plan.md, sections 45 and 46. Written by make_s2b.py.
#
# The clock: as s2a's.
create_clock -period 10.000 -name fclk0 [get_pins ps7/FCLKCLK[0]]

# The LUT RAM: four memories on each of 110 SLICEM sites. Only the site is constrained; which of the site's four
# LUT positions each memory gets is Vivado's to say (s2a.xdc says what was tried), and the build's record states it.
set_property LOC SLICE_X16Y0 [get_cells {regs/at[0].ram0/SP}]
set_property LOC SLICE_X16Y0 [get_cells {regs/at[0].ram1/SP}]
set_property LOC SLICE_X16Y0 [get_cells {regs/at[0].ram2/SP}]
