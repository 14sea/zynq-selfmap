{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "ram_map 2 — at every probed site, which bit of configuration memory is which cell of a probe design's LUT RAM",
 "description": "zynq-selfmap, S2.5 (docs/s2_plan.md, sections 45 and 46). Written by host/s2_5_table.py from the verdicts of stored runs and from what part 1's chain found. It is ram_map 1 with the site added to an entry, for a design with RAM at many sites; and since every site was written alike, what an entry rests on is said once for each cell and not in every entry. Closed-book: nothing in a document of this form comes from a database or from a bitstream.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema",
  "schema_version",
  "label",
  "what",
  "design",
  "numbering",
  "sites",
  "cells_a_site",
  "confidence",
  "runs",
  "evidence",
  "counts",
  "entries"
 ],
 "properties": {
  "schema": {
   "const": "ram_map"
  },
  "schema_version": {
   "const": 2
  },
  "label": {
   "const": "closed-book"
  },
  "what": {
   "type": "string"
  },
  "design": {
   "type": "string",
   "description": "the probe design whose RAM this is (its name in its own record, pl/<name>/design.json)"
  },
  "numbering": {
   "type": "string",
   "description": "how a cell's number is made from the design's side"
  },
  "sites": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "site",
     "name"
    ],
    "properties": {
     "site": {
      "type": "integer",
      "minimum": 0
     },
     "name": {
      "type": "string",
      "description": "the design's record of where the build placed the site's memories"
     }
    }
   }
  },
  "cells_a_site": {
   "type": "integer",
   "minimum": 1
  },
  "confidence": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "0",
    "1",
    "2"
   ],
   "properties": {
    "0": {
     "type": "string"
    },
    "1": {
     "type": "string"
    },
    "2": {
     "type": "string"
    }
   }
  },
  "runs": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "code",
    "singles"
   ],
   "properties": {
    "code": {
     "$ref": "#/$defs/run"
    },
    "singles": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "dir",
       "share",
       "result_sha256"
      ],
      "properties": {
       "dir": {
        "type": "string"
       },
       "share": {
        "type": "integer",
        "minimum": 0
       },
       "result_sha256": {
        "$ref": "#/$defs/sha256"
       }
      }
     }
    }
   }
  },
  "evidence": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "what",
    "reads",
    "of_a_cell"
   ],
   "properties": {
    "what": {
     "type": "string"
    },
    "reads": {
     "type": "array",
     "items": {
      "type": "array",
      "prefixItems": [
       {
        "type": "string",
        "pattern": "^0x[0-9a-f]{8}$"
       },
       {
        "type": "integer",
        "minimum": 1
       }
      ],
      "minItems": 2,
      "maxItems": 2
     },
     "description": "the reads of every run of part 2, in order: the address read from and how many frames"
    },
    "of_a_cell": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "cell",
       "state",
       "code_states",
       "single"
      ],
      "properties": {
       "cell": {
        "type": "integer",
        "minimum": 0
       },
       "state": {
        "enum": [
         "decoded",
         "confirmed",
         "contradiction"
        ]
       },
       "code_states": {
        "type": "array",
        "items": {
         "type": "integer",
         "minimum": 0
        },
        "description": "the states of the code run in which the cell was one at every site"
       },
       "single": {
        "oneOf": [
         {
          "type": "null"
         },
         {
          "type": "object",
          "additionalProperties": false,
          "required": [
           "run",
           "state"
          ],
          "properties": {
           "run": {
            "type": "string"
           },
           "state": {
            "type": "integer",
            "minimum": 0
           }
          }
         }
        ]
       }
      }
     }
    }
   }
  },
  "counts": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "confirmed",
    "decoded",
    "contradiction"
   ],
   "properties": {
    "confirmed": {
     "type": "integer",
     "minimum": 0
    },
    "decoded": {
     "type": "integer",
     "minimum": 0
    },
    "contradiction": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "entries": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "address",
     "site",
     "cell",
     "memory",
     "ram_address",
     "inverted",
     "confidence",
     "state"
    ],
    "properties": {
     "address": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{8}/[0-9]+/[0-9]+$",
      "description": "frame address / word / bit"
     },
     "site": {
      "type": "integer",
      "minimum": 0
     },
     "cell": {
      "type": "integer",
      "minimum": 0
     },
     "memory": {
      "type": "integer",
      "minimum": 0
     },
     "ram_address": {
      "type": "integer",
      "minimum": 0
     },
     "inverted": {
      "type": "boolean",
      "description": "the place reads the opposite of what the cell holds"
     },
     "confidence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
     },
     "state": {
      "enum": [
       "decoded",
       "confirmed",
       "contradiction"
      ]
     }
    }
   }
  }
 },
 "$defs": {
  "sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "run": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "dir",
    "result_sha256"
   ],
   "properties": {
    "dir": {
     "type": "string"
    },
    "result_sha256": {
     "$ref": "#/$defs/sha256"
    }
   }
  }
 }
}
